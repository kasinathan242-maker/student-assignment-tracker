{
  "name": "@sat/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API, background worker and operational scripts.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "db:local": "tsx src/scripts/localMongo.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "bootstrap:platform-admin": "tsx --env-file-if-exists=../../.env src/scripts/bootstrapPlatformAdmin.ts",
    "openapi": "tsx src/scripts/writeOpenApi.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "perf": "tsx src/scripts/perf.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@node-rs/argon2": "2.2.2",
    "@sat/shared": "*",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "csv-parse": "7.0.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "luxon": "3.7.2",
    "mongoose": "9.11.1",
    "multer": "2.4.0",
    "nodemailer": "10.0.16",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "rate-limit-redis": "6.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@sat/config": "*",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
