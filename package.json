{
  "name": "student-assignment-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant student assignment tracker: courses, assignments, submissions, grading, notifications and reporting.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @sat/api",
    "dev:web": "npm run dev -w @sat/web",
    "dev:worker": "npm run dev:worker -w @sat/api",
    "db:local": "npm run db:local -w @sat/api",
    "seed": "npm run seed -w @sat/api --",
    "bootstrap:platform-admin": "npm run bootstrap:platform-admin -w @sat/api --",
    "build": "npm run build -w @sat/api && npm run build -w @sat/web",
    "start": "node scripts/start.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test -w @sat/api",
    "test:web": "npm run test -w @sat/web",
    "test:shared": "npm run test -w @sat/shared",
    "test:e2e": "npm run test:e2e -w @sat/web",
    "openapi": "npm run openapi -w @sat/api",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@sat/eslint-config": "*",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "mongodb-memory-server@11.3.0": true
  }
}
