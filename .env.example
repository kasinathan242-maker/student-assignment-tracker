# Student Assignment Tracker — environment configuration.
# Copy to .env for local development. Never commit .env or put real secrets in this file.
# Every variable is documented in docs/configuration.md.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the web app (used in email links and as the default CORS origin).
APP_URL=http://localhost:5173
# Comma-separated additional allowed origins (optional).
CORS_ORIGINS=
# Express "trust proxy": number of hops or "loopback". Set to 1 behind a single reverse proxy.
TRUST_PROXY=loopback
LOG_LEVEL=debug

# ── Database (MongoDB replica set — transactions require one) ──────────────
# `npm run db:local` starts a local replica set on this port (no Docker needed).
MONGO_URI=mongodb://127.0.0.1:27018/sat?replicaSet=rs0

# ── Secrets (REQUIRED in production: 32+ random characters each, different values) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
CSRF_SECRET=
# Must be true in production (HTTPS only).
COOKIE_SECURE=false
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ── Rate limiting (optional Redis shares counters across API instances) ─────
REDIS_URL=
RATE_LIMIT_ENABLED=true

# ── Email ───────────────────────────────────────────────────────────────────
# file: writes messages to DEV_MAILBOX_DIR (view at /dev/mail in development)
# smtp: real delivery through any SMTP provider (required in production)
EMAIL_PROVIDER=file
EMAIL_FROM=Assignment Tracker <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
DEV_MAILBOX_DIR=../../.data/mail
DEV_MAILBOX_ENABLED=true
# true: new accounts must confirm their email before signing in (needs real email delivery).
REQUIRE_EMAIL_VERIFICATION=false

# ── File storage ────────────────────────────────────────────────────────────
# local: files under LOCAL_STORAGE_DIR; s3: any S3-compatible service (AWS S3, Cloudflare R2…)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=../../.data/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Malware scanning ────────────────────────────────────────────────────────
# none: files are marked "skipped" (not treated as clean). clamav: scan via clamd.
MALWARE_SCANNER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Block downloads until a file has a clean scan result.
REQUIRE_CLEAN_SCAN=false

# ── Background worker ───────────────────────────────────────────────────────
# true: run jobs inside the API process (development). Production runs `npm run start:worker` separately.
RUN_WORKER_INLINE=true
WORKER_POLL_MS=5000
SCHEDULER_INTERVAL_MS=30000

# ── Error reporting ─────────────────────────────────────────────────────────
# log: structured logs only. webhook: also POST sanitized error events to ERROR_WEBHOOK_URL.
ERROR_REPORTER=log
ERROR_WEBHOOK_URL=
